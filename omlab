trigger_app() {
  curl -sf -X POST -H "Authorization: Bearer $OM_TOKEN" -H "Content-Type: application/json" \
    -d '{}' "$OM_HOST/api/v1/apps/trigger/$1" >/dev/null
}

# ---------------------------------------------------------------------
# Documentation — sur la machine hôte, avec uv et un navigateur Playwright
# ---------------------------------------------------------------------
need_browser() {
  command -v uv >/dev/null || { c_err "uv est requis : https://docs.astral.sh/uv/"; exit 1; }
  uv run -q --python 3.12 --with playwright==1.58.0 playwright install chromium
}

cmd_captures() {
  need_browser
  uv run -q --script scripts/captures.py "$@"
}

cmd_couverture() {
  python3 scripts/couverture.py
}

cmd_check_docs() {
  need_browser
  uv run -q --script scripts/check_docs.py "$@"
}

# ---------------------------------------------------------------------
# Les autres familles de sources du chapitre 23
# ---------------------------------------------------------------------
cmd_sources() {
  case "${1:-}" in
    up)
      c_head "Démarrage des sources : Kafka, S3, MLflow, Metabase, fichiers"
      dc_src up -d omlab-redpanda omlab-s3 omlab-mlflow omlab-metabase omlab-fichiers ;;
    dbt)
      c_head "dbt run, dbt docs generate, dbt test"
      dc_src run --rm omlab-dbt run
      dc_src run --rm omlab-dbt docs generate
      # En dernier : chaque commande réécrit run_results.json, et le catalogue y lit les tests.
      dc_src run --rm omlab-dbt test ;;
    down)
      dc_src stop omlab-redpanda omlab-s3 omlab-mlflow omlab-metabase omlab-fichiers ;;
    *) c_err "Usage : ./omlab sources up|dbt|down"; exit 1 ;;
  esac
}

# =====================================================================
cmd_help() {
  cat <<'EOF'
omlab — laboratoire OpenMetadata

  Cycle de vie
    ./omlab up                 démarre toute la stack et attend qu'elle réponde
    ./omlab status             état des conteneurs
    ./omlab logs [service]     suit les logs (défaut : openmetadata-server)
    ./omlab down               arrête (les données restent)
    ./omlab nuke               supprime tout, volumes compris

  Terrain de jeu
    ./omlab psql               ouvre un psql sur la base omlab
    ./omlab psql "SELECT 1"    exécute une requête
    ./omlab traffic            rejoue du trafic SQL (avant usage/lineage)

  OpenMetadata
    ./omlab token              récupère le JWT de l'ingestion-bot dans .env
    ./omlab ingest  <fichier.yaml>    workflow de métadonnées / lineage
    ./omlab profile <fichier.yaml>    workflow de profiling
    ./omlab test    <fichier.yaml>    workflow de qualité de données
    ./omlab usage    <fichier.yaml>   workflow d'usage
    ./omlab classify <fichier.yaml>   échantillonnage + détection de PII
    ./omlab app      <fichier.yaml>   application interne (réindexation...)
    ./omlab py       <script.py>      exécute un script du SDK
    ./omlab demo               rejoue tous les TP, du chapitre 04 au 24

  Autres sources (chapitre 23)
    ./omlab sources up         démarre Kafka, S3, MLflow, Metabase
    ./omlab sources dbt        exécute le projet dbt du TP
    ./omlab sources down       arrête ces conteneurs

  Vérifications
    ./omlab check              lance toutes les vérifications de chapitre
    ./omlab check 04           lance celle du chapitre 04
    ./omlab check-docs         contrôle la doc : schémas, liens, Mermaid (hôte, uv)
    ./omlab couverture         mesure la couverture de la documentation officielle

  Mode d'emploi
    ./omlab captures [07 10]   refait les captures d'écran de cours/img (hôte, uv)
EOF
}

# =====================================================================
main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    up|wait|down|nuke|status|logs|psql|traffic|token|ingest|profile|test|usage|classify|app|py|demo|check|captures|sources|couverture|help)
      "cmd_$cmd" "$@" ;;
    check-docs) cmd_check_docs "$@" ;;
    *) c_err "Commande inconnue : $cmd"; echo; cmd_help; exit 1 ;;
  esac
}

main "$@"
