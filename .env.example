# =====================================================================
# omlab — configuration locale
# =====================================================================
# Copiez ce fichier en .env :   cp .env.example .env
# Puis remplissez OM_TOKEN automatiquement :   ./omlab token
# =====================================================================

# --- OpenMetadata ---------------------------------------------------
OM_HOST=http://localhost:8585
OM_ADMIN_USER=admin@open-metadata.org
OM_ADMIN_PASSWORD=admin
OM_BOT_NAME=ingestion-bot

# Rempli par `./omlab token`. Ne pas committer un vrai jeton.
OM_TOKEN=

# Depuis l'intérieur des conteneurs, le serveur ne s'appelle pas localhost
OM_HOST_INTERNAL=http://openmetadata-server:8585

# Port du récepteur de webhooks côté hôte (chapitre 12).
# À changer si 8010 est déjà pris chez vous.
OMLAB_WEBHOOK_PORT=8010

# --- Terrain de jeu Postgres ----------------------------------------
# Depuis l'hôte
OMLAB_PG_HOST=localhost
OMLAB_PG_PORT=5433
# Depuis les conteneurs (c'est ce que voit le conteneur d'ingestion)
OMLAB_PG_HOST_INTERNAL=omlab-postgres
OMLAB_PG_PORT_INTERNAL=5432

OMLAB_PG_DB=omlab
OMLAB_PG_USER=om_reader
OMLAB_PG_PASSWORD=om_reader_pwd

# --- Noms de service dans OpenMetadata -------------------------------
# Utilisés par tous les YAML et scripts des TP. Si vous les changez ici,
# changez-les aussi dans les fichiers tp/ (ils sont écrits en dur).
OMLAB_SERVICE_NAME=omlab_postgres
